     "preparationGroups": [
      {
       "name": "Kødsauce",
       "steps": [
        {
         "step": "Varm en stor pande med lidt olivenolie. Tilføj hakket løg og steg, indtil de er gennemsigtige."
        },
        {
         "step": "Tilføj hvidløg og hakket oksekød, og brun det, indtil kødet er godt gennemstegt."
        },
        {
         "step": "Riv gulerødderne og tilsæt dem sammen med de hakkede tomater, tomatpuré, oksebouillon, oregano, og basilikum. Lad det simre under låg på lav varme i mindst 30 minutter. Smag til med salt og peber."
        }
       ]
      },
      {
       "name": "Béchamelsauce",
       "steps": [
        {
         "step": "Smelt smør i en gryde, tilføj mel og rør godt. Lad det simre et par minutter uden at tage farve."
        },
        {
         "step": "Tilsæt gradvist mælken under konstant omrøring for at undgå klumper. Fortsæt med at røre, indtil saucen tykner og er glat."
        },
        {
         "step": "Smag til med salt, peber og en knivspids muskatnød."
        }
       ]
      },
      {
       "name": "Lasagne",
       "steps": [
        {
         "step": "Forvarm ovnen til 180°C."
        },
        {
         "step": "I et ovnfast fad, start med et lag kødsauce, derefter et lag lasagneplader, og et lag béchamelsauce. Gentag, indtil alle ingredienserne er brugt, og sørg for, at det øverste lag er béchamelsauce."
        },
        {
         "step": "Drys med mozzarella og rasp på toppen."
        },
        {
         "step": "Dæk fadet med aluminiumsfolie og bag i ovnen i 20 minutter. Fjern folien og bag yderligere 25-30 minutter, eller indtil overfladen er gylden og boblende. Lad lasagnen hvile i 10 minutter før servering. Dette gør det lettere at skære og servere."
        }
       ]
      }
     ],
